# Database
DATABASE_URL=postgresql+asyncpg://aris:aris@postgres:5432/aris
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (RS256)
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_DEV_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_DEV_PUBLIC_KEY\n-----END PUBLIC KEY-----"
