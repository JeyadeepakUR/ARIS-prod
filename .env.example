# ── Quickstart ────────────────────────────────────────────────────────────────
# 1. Copy this file:          cp .env.example .env
# 2. Generate JWT keys:       python scripts/gen_jwt_keys.py >> .env
# 3. Pick an LLM provider (see LLM section below)
# 4. Start the stack:         docker compose up --build
#    Or local dev:            uvicorn apps.api.main:app --reload
#                             python -m apps.worker.main

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev defaults to SQLite (zero setup). Switch to Postgres+pgvector for
# production: DATABASE_URL=postgresql+asyncpg://aris:aris@localhost:5432/aris
DATABASE_URL=sqlite+aiosqlite:///./aris_platform.db
DATABASE_ECHO=false

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: ollama | groq | openrouter | openai | anthropic | mock
#
#   mock        — no API calls, deterministic responses; ideal for tests
#   ollama      — local, completely free (install from https://ollama.com)
#   groq        — free tier cloud (https://console.groq.com)
#   openrouter  — free models available (https://openrouter.ai)
LLM_PROVIDER=mock
# Recommended free OpenRouter model for concept extraction:
#   meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=
LLM_API_KEY=

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Requires: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true to skip Celery entirely (tasks run inline, no worker needed)
CELERY_TASK_ALWAYS_EAGER=false

# ── Object Storage ────────────────────────────────────────────────────────────
# Leave S3 vars blank → local filesystem fallback (dev only)
S3_BUCKET_NAME=aris-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with:  python scripts/gen_jwt_keys.py >> .env
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nArisdevKeyPriv\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nArisdevKeyPub\n-----END PUBLIC KEY-----"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Baked into the Next.js bundle at build time (see apps/web/Dockerfile ARG)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM Observability — Langfuse (optional, self-hosted) ─────────────────────
# Start with:  docker compose --profile observability up langfuse
# Then visit http://localhost:3001, create a project, paste keys below.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET=changeme-in-production
LANGFUSE_SALT=changeme-in-production
